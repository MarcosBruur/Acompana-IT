DATABASE_URL=postgresql+psycopg://tfg:tfg_local@127.0.0.1:5433/tfg
# Recomendado para límites compartidos en varios procesos (docker compose up -d redis):
# REDIS_URL=redis://127.0.0.1:6379/0
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
# MEDIA_DIR=./app/media
# BACKUP_DIR=D:/respaldos/tfg
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/17/bin/pg_dump.exe
# Alternativa local si pg_dump no está instalado en el host:
# BACKUP_DB_CONTAINER=tfg-db-1
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OPENAI_API_KEY=sk-...
# Modelo común si no se indican modelos específicos (predeterminado: gpt-4.1-mini).
# OPENAI_MODEL=gpt-4.1-mini
# Descomentar para probar modelos distintos en cada módulo.
# OPENAI_VACANCY_MODEL=gpt-4.1-mini
# OPENAI_INTERVIEW_MODEL=gpt-4.1-mini
# Audio de entrevistas: Realtime y voz. Opcionales; estos son los predeterminados.
# OPENAI_VOICE_MODEL=gpt-realtime-2.1-mini
# OPENAI_VOICE=marin
# Para probar mayor fidelidad al acento: OPENAI_VOICE_MODEL=gpt-realtime-2
# Para comparar timbres: OPENAI_VOICE=cedar
